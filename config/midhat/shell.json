{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "midhat.clock",
    "layout": {
      "left": [
        {
          "id": "midhat.menu"
        },
        {
          "id": "midhat.workspaces"
        }
      ],
      "center": [
        {
          "id": "midhat.indicators"
        },
        {
          "id": "midhat.reading-mode"
        },
        {
          "id": "midhat.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "midhat.keyboard-layout"
        },
        {
          "id": "midhat.system-update"
        }
      ],
      "right": [
        {
          "id": "midhat.tray"
        },
        {
          "id": "midhat.agents"
        },
        {
          "id": "midhat.status"
        },
        {
          "id": "midhat.power"
        }
      ]
    }
  },
  "slate": {
    "bar": {
      "position": "left",
      "transparent": false,
      "centerAnchor": "",
      "layout": {
        "left": [
          {
            "id": "midhat.slate-button",
            "action": "home"
          },
          {
            "id": "midhat.slate-button",
            "action": "read"
          },
          {
            "id": "midhat.slate-button",
            "action": "ask"
          }
        ],
        "center": [
          {
            "id": "midhat.active-window",
            "spine": true,
            "maxWidth": 440
          }
        ],
        "right": [
          {
            "id": "midhat.slate-button",
            "action": "keyboard"
          },
          {
            "id": "midhat.slate-button",
            "action": "settings"
          },
          {
            "id": "midhat.power"
          }
        ]
      }
    }
  },
  "plugins": []
}
