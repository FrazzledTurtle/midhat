_etc_overrides_apply() {
  echo "Applying Mid'hat etc-overrides..."

  install -d /etc/security /etc/skel

  # These copies are intentionally destructive on every install/upgrade: the
  # paths are owned by upstream Arch packages, so pacman's backup=() cannot
  # protect them. Local edits to these files are reset to Mid'hat's defaults.
  rm -f /etc/os-release
  cp -f /usr/share/midhat/etc-overrides/os-release             /etc/os-release
  cp -f /usr/share/midhat/etc-overrides/security-faillock.conf /etc/security/faillock.conf
  cp -f /usr/share/midhat/etc-overrides/nsswitch.conf          /etc/nsswitch.conf
  if [[ -f /etc/cups/cups-browsed.conf ]]; then
    cp -f /usr/share/midhat/etc-overrides/cups-cups-browsed.conf /etc/cups/cups-browsed.conf
    chmod 0644 /etc/cups/cups-browsed.conf
  fi
  cp -f /usr/share/midhat/etc-overrides/dot.bashrc             /etc/skel/.bashrc
  chmod 0644 /etc/os-release /etc/security/faillock.conf /etc/nsswitch.conf /etc/skel/.bashrc
}

# The pen-hold plugin as installed by hand on 2026-11-16, before it was packaged.
_pen_hold_remove_hand_install() {
  rm -f /etc/libinput/plugins/pen-hold.lua /etc/libinput/pen-hold.lua.off \
    /usr/local/bin/pen-hold-guard /etc/pacman.d/hooks/pen-hold-guard.hook \
    /etc/systemd/system/sddm.service.d/pen-hold-guard.conf
  rmdir /etc/systemd/system/sddm.service.d 2>/dev/null || true
}

# Opens connected cameras' authorized attribute to the video group now, not at
# the next boot or replug.
_camera_rule_apply() {
  udevadm control --reload 2>/dev/null || return 0
  udevadm trigger --action=change --subsystem-match=usb --attr-match=bInterfaceClass=0e 2>/dev/null || true
}

post_install() {
  _etc_overrides_apply
  _camera_rule_apply
  _pen_hold_remove_hand_install
  /usr/bin/midhat-pen-hold-guard
}

post_upgrade() {
  _etc_overrides_apply
  _camera_rule_apply
  _pen_hold_remove_hand_install
  /usr/bin/midhat-pen-hold-guard
}

post_remove() {
  rm -f /etc/libinput/plugins/midhat-pen-hold.lua
}
