# Maintainer: FrazzledTurtle
# Mid'hat system defaults: /etc drop-ins, /etc/skel, fonts, greeter, os-release.
# Built from this repository's committed HEAD (git archive); set
# MIDHAT_SRC=/path/to/tree to build a working tree instead.
#
# Differences from omarchy-settings 4.0.5:
#  - no plymouth (the FydeTab boots through U-Boot without a splash), so no
#    plymouth dependency, theme or plymouthd.conf override
#  - no Limine or mkinitcpio drop-ins (no UEFI, no encrypted root here)
#  - the zram, systemd-oomd and sysctl memory tuning ships on aarch64 too,
#    as the FydeTab build of 4.0.5 did
#  - os-release names Mid'hat
pkgname='midhat-settings'
pkgver=0.1.11
pkgrel=1
pkgdesc="Mid'hat user defaults, /etc/skel content, fonts, greeter theme and support helpers"
arch=('aarch64')
url='https://github.com/FrazzledTurtle/midhat'
license=('MIT')
options=('!debug' '!strip')
conflicts=('omarchy-settings' 'omarchy-settings-dev')
replaces=('omarchy-settings')
depends=(
  'bash'
  'curl'
  'gum'
  'hicolor-icon-theme'
)
makedepends=('git')
optdepends=(
  "midhat: Full Mid'hat desktop"
  'inxi: System information for midhat-debug'
  'fastfetch: System information for midhat-upload-log'
  'zram-generator: Compressed swap from the shipped zram-generator drop-in'
)
backup=(
  'etc/fastfetch/config.jsonc'
  'etc/docker/daemon.json'
  'etc/gnupg/dirmngr.conf'
  'etc/sysctl.d/99-midhat-sysctl.conf'
  'etc/sysctl.d/90-midhat-file-watchers.conf'
  'etc/systemd/logind.conf.d/10-ignore-power-button.conf'
  'etc/systemd/logind.conf.d/20-inhibit-delay.conf'
  'etc/systemd/resolved.conf.d/10-disable-multicast.conf'
  'etc/systemd/resolved.conf.d/20-docker-dns.conf'
  'etc/systemd/system.conf.d/10-faster-shutdown.conf'
  'etc/systemd/system/user@.service.d/10-faster-shutdown.conf'
  'etc/systemd/system/docker.service.d/no-block-boot.conf'
  'etc/systemd/system/plocate-updatedb.service.d/ac-only.conf'
  'etc/systemd/system.conf.d/20-midhat-nofile.conf'
  'etc/systemd/user.conf.d/20-midhat-nofile.conf'
  'etc/sddm.conf.d/10-theme.conf'
  'etc/sddm.conf.d/10-wayland.conf'
  'etc/modprobe.d/midhat-usb-autosuspend.conf'
  'etc/systemd/oomd.conf.d/10-midhat.conf'
)
install='midhat-settings.install'
source=()
sha256sums=()

# Live config files owned by upstream Arch packages: shipped under
# /usr/share/midhat/etc-overrides/ and copied into place by the install script.
_etc_override_paths=(
  'etc/security/faillock.conf'
  'etc/nsswitch.conf'
  'etc/cups/cups-browsed.conf'
  'etc/cups/cups-files.conf'
)

_root=$(cd "$startdir/../.." && pwd)

prepare() {
  rm -rf "$srcdir/midhat"
  mkdir -p "$srcdir/midhat"
  if [[ -n ${MIDHAT_SRC:-} ]]; then
    cp -a "$MIDHAT_SRC/." "$srcdir/midhat/"
  else
    git -C "$_root" archive HEAD | tar -x -C "$srcdir/midhat"
  fi
}

package() {
  cd "$srcdir/midhat"

  # /etc/skel/.config from config/**, and the same tree under /usr/share/midhat
  # for midhat-refresh-config and friends.
  install -d "$pkgdir/etc/skel/.config" "$pkgdir/usr/share/midhat/config"
  cp -a config/. "$pkgdir/etc/skel/.config/"
  cp -a config/. "$pkgdir/usr/share/midhat/config/"

  install -Dm644 etc/fastfetch/config.jsonc "$pkgdir/etc/fastfetch/config.jsonc"

  install -Dm644 default/uwsm/env.d/10-midhat "$pkgdir/usr/share/uwsm/env.d/10-midhat"
  install -Dm644 default/environment.d/10-midhat-fcitx.conf "$pkgdir/usr/lib/environment.d/10-midhat-fcitx.conf"
  install -Dm644 default/fontconfig/conf.avail/50-midhat.conf "$pkgdir/usr/share/fontconfig/conf.avail/50-midhat.conf"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -sfn /usr/share/fontconfig/conf.avail/50-midhat.conf "$pkgdir/etc/fonts/conf.d/50-midhat.conf"
  install -Dm644 default/xdg-terminal-exec/hyprland-xdg-terminals.list "$pkgdir/usr/share/xdg-terminal-exec/hyprland-xdg-terminals.list"
  install -Dm644 default/applications/mimeapps.list "$pkgdir/usr/share/applications/mimeapps.list"

  local unit
  for unit in bt-agent midhat-sleep-lock midhat-recover-internal-monitor midhat-migrate-notify \
    midhat-tailscale-receive midhat-fcitx5 midhat-crash-watch; do
    install -Dm644 "default/systemd/user/$unit.service" "$pkgdir/usr/lib/systemd/user/$unit.service"
  done
  install -Dm644 default/systemd/user/app.slice.d/10-oomd.conf "$pkgdir/usr/lib/systemd/user/app.slice.d/10-oomd.conf"
  install -Dm644 default/systemd/zram-generator.conf.d/90-midhat.conf "$pkgdir/usr/lib/systemd/zram-generator.conf.d/90-midhat.conf"
  install -Dm644 default/systemd/system/plocate-updatedb.service.d/10-midhat.conf \
    "$pkgdir/usr/lib/systemd/system/plocate-updatedb.service.d/10-midhat.conf"

  install -d "$pkgdir/usr/share/midhat/applications"
  cp -a applications/. "$pkgdir/usr/share/midhat/applications/"
  rm -rf "$pkgdir/usr/share/midhat/applications/icons"

  install -d "$pkgdir/etc"
  cp -a etc/. "$pkgdir/etc/"
  # No UEFI, Limine or encrypted root on the tablet.
  rm -rf "$pkgdir/etc/mkinitcpio.conf.d" "$pkgdir/etc/limine-entry-tool.d"
  if [[ -d $pkgdir/etc/sudoers.d ]]; then
    chmod 0750 "$pkgdir/etc/sudoers.d"
    chmod 0440 "$pkgdir/etc/sudoers.d"/*
  fi

  install -d "$pkgdir/usr/share/midhat/etc-overrides"
  install -Dm644 default/bashrc "$pkgdir/usr/share/midhat/etc-overrides/dot.bashrc"
  cat >"$pkgdir/usr/share/midhat/etc-overrides/os-release" <<EOF
NAME="Mid'hat"
PRETTY_NAME="Mid'hat"
ID=midhat
ID_LIKE=arch
BUILD_ID="$pkgver"
VERSION_ID="$pkgver"
ANSI_COLOR="0;37"
HOME_URL="$url"
BUG_REPORT_URL="$url/issues"
LOGO=midhat
EOF
  local path
  for path in "${_etc_override_paths[@]}"; do
    case "$path" in
      'etc/security/faillock.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/midhat/etc-overrides/security-faillock.conf" ;;
      'etc/nsswitch.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/midhat/etc-overrides/nsswitch.conf" ;;
      'etc/cups/cups-browsed.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/midhat/etc-overrides/cups-cups-browsed.conf" ;;
      'etc/cups/cups-files.conf')
        [[ ! -f $pkgdir/$path ]] || mv "$pkgdir/$path" "$pkgdir/usr/share/midhat/etc-overrides/cups-cups-files.conf" ;;
    esac
  done
  rm -f "$pkgdir/etc/plymouth/plymouthd.conf"
  rmdir "$pkgdir/etc/security" "$pkgdir/etc/cups" "$pkgdir/etc/plymouth" 2>/dev/null || true

  install -d "$pkgdir/etc/skel/.local/share/applications"
  if compgen -G 'applications/*.desktop' >/dev/null; then
    cp applications/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi
  if [[ -d applications/hidden ]] && compgen -G 'applications/hidden/*.desktop' >/dev/null; then
    cp applications/hidden/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi

  if [[ -d applications/icons ]] && compgen -G 'applications/icons/*' >/dev/null; then
    install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps" "$pkgdir/usr/share/icons/hicolor/48x48/apps"
    local icon icon_name icon_id
    for icon in applications/icons/*; do
      [[ -f $icon ]] || continue
      icon_name=$(basename "$icon")
      icon_id=$(printf '%s\n' "${icon_name%.*}" | tr '[:upper:]' '[:lower:]' |
        sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
      case "$icon_name" in
        *.svg)
          install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon_id.svg"
          ;;
        *)
          magick "$icon" -thumbnail 256x256 -background transparent -gravity center -extent 256x256 \
            "PNG32:$pkgdir/usr/share/icons/hicolor/256x256/apps/$icon_id.png"
          magick "$icon" -thumbnail 48x48 -background transparent -gravity center -extent 48x48 \
            "PNG32:$pkgdir/usr/share/icons/hicolor/48x48/apps/$icon_id.png"
          ;;
      esac
    done
  fi

  install -d "$pkgdir/usr/share/midhat/default"
  cp -a default/. "$pkgdir/usr/share/midhat/default/"
  install -Dm644 default/snapper/root "$pkgdir/etc/snapper/config-templates/midhat"

  install -d -m 0755 "$pkgdir/usr/share/sddm/themes"
  cp -a default/sddm/midhat "$pkgdir/usr/share/sddm/themes/"
  find "$pkgdir/usr/share/sddm/themes/midhat" -type d -exec chmod 0755 {} +
  find "$pkgdir/usr/share/sddm/themes/midhat" -type f -exec chmod 0644 {} +
  install -Dm644 default/sddm/hyprland.lua "$pkgdir/usr/share/sddm/hyprland.lua"
  install -Dm644 default/wayland-sessions/midhat.desktop "$pkgdir/usr/local/share/wayland-sessions/midhat.desktop"

  install -Dm644 default/fonts/midhat/midhat.ttf "$pkgdir/usr/share/fonts/midhat/midhat.ttf"
  install -Dm755 default/systemd/system-sleep/unmount-fuse "$pkgdir/usr/lib/systemd/system-sleep/unmount-fuse"
  install -Dm755 default/systemd/system-sleep/midhat-tablet-mode "$pkgdir/usr/lib/systemd/system-sleep/midhat-tablet-mode"
  install -Dm644 default/udev/90-midhat-pen-touch.rules "$pkgdir/usr/lib/udev/rules.d/90-midhat-pen-touch.rules"
  install -Dm644 default/udev/91-midhat-camera.rules "$pkgdir/usr/lib/udev/rules.d/91-midhat-camera.rules"
  install -Dm755 bin/midhat-pen-hold-guard "$pkgdir/usr/bin/midhat-pen-hold-guard"
  install -Dm644 default/libalpm/hooks/95-midhat-pen-hold.hook "$pkgdir/usr/share/libalpm/hooks/95-midhat-pen-hold.hook"
  install -Dm644 default/systemd/system/sddm.service.d/midhat-pen-hold.conf \
    "$pkgdir/usr/lib/systemd/system/sddm.service.d/midhat-pen-hold.conf"

  install -Dm644 logo.txt "$pkgdir/usr/share/midhat/logo.txt"
  install -Dm644 logo.svg "$pkgdir/usr/share/midhat/logo.svg"
  install -Dm644 icon.txt "$pkgdir/usr/share/midhat/icon.txt"
  install -Dm644 icon.png "$pkgdir/usr/share/midhat/icon.png"
  install -Dm644 icon.png "$pkgdir/usr/share/pixmaps/midhat.png"
  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/midhat.png"
  install -Dm644 logo.txt "$pkgdir/etc/skel/.config/midhat/branding/screensaver.txt"
  install -Dm644 icon.txt "$pkgdir/etc/skel/.config/midhat/branding/about.txt"

  install -Dm644 default/hypr/toggles/flags.lua "$pkgdir/etc/skel/.local/state/midhat/toggles/hypr/flags.lua"
  install -Dm644 default/nautilus-python/extensions/localsend.py "$pkgdir/etc/skel/.local/share/nautilus-python/extensions/localsend.py"
  install -Dm644 default/nautilus-python/extensions/transcode.py "$pkgdir/etc/skel/.local/share/nautilus-python/extensions/transcode.py"
  install -Dm644 default/tensaku/state.toml "$pkgdir/etc/skel/.local/state/tensaku/state.toml"

  install -Dm755 bin/midhat-upload-log "$pkgdir/usr/bin/midhat-upload-log"
  install -Dm755 bin/midhat-debug "$pkgdir/usr/bin/midhat-debug"
  install -Dm755 bin/midhat-debug-idle "$pkgdir/usr/bin/midhat-debug-idle"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
