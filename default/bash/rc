: "${MIDHAT_PATH:=/usr/share/midhat}"
source "$MIDHAT_PATH/default/bash/envs"
source "$MIDHAT_PATH/default/bash/shell"
source "$MIDHAT_PATH/default/bash/aliases"
source "$MIDHAT_PATH/default/bash/functions"
source "$MIDHAT_PATH/default/bash/init"
[[ $- == *i* ]] && bind -f "$MIDHAT_PATH/default/bash/inputrc"
