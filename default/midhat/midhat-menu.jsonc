{
  // Mid’hat menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `midhat menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "root": {"label":"Mid’hat"},
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "read": {"icon":"󱉟","label":"Read"},
  "read.library": {"icon":"󰌱","label":"Library","action":"midhat-launch-or-focus rocks.koreader.KOReader koreader"},
  "read.open-pdf": {"icon":"󰈦","label":"Open PDF","action":"file=$(midhat-file-select --title \"Open PDF\" --extensions \"pdf\") && uwsm-app -- zathura \"$file\""},
  "read.write-pdf": {"icon":"󱦹","label":"Write on PDF","action":"file=$(midhat-file-select --title \"Write on PDF\" --extensions \"pdf\") && uwsm-app -- xournalpp \"$file\""},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"midhat-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"midhat-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"midhat-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! midhat-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"midhat-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"midhat-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"midhat-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"midhat-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"midhat-menu-keybindings"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"midhat-launch-browser 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"midhat-launch-browser 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"midhat-launch-browser 'https://www.lazyvim.org/keymaps'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"midhat-menu-tmux-keybindings"},

  // Trigger
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"midhat-capture-screenshot"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"midhat-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"midhat-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"midhat-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.power": {"icon":"󱐋","label":"Power"},
  "trigger.power.balanced": {"icon":"󰗑","label":"Balanced","checked":"[[ $(powerprofilesctl get) == balanced ]]","action":"midhat-powerprofiles-set autodetect balanced"},
  "trigger.power.power-saver": {"icon":"󰌪","label":"Power Saving","checked":"[[ $(powerprofilesctl get) == power-saver ]]","action":"midhat-powerprofiles-set autodetect power-saver"},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"midhat-hw-laptop","action":"midhat-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"midhat-hw-laptop","action":"midhat-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"midhat-hw-hybrid-gpu","action":"midhat-launch-floating-terminal-with-presentation midhat-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"midhat-hw-touchpad","action":"midhat-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"midhat-hw-dell-xps-haptic-touchpad && midhat-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"midhat-hw-dell-xps-haptic-touchpad && midhat-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"midhat-hw-dell-xps-haptic-touchpad && midhat-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"midhat-hw-touchscreen","action":"midhat-toggle-touchscreen"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"midhat-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"midhat-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"midhat-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"midhat-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"midhat-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"midhat-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"midhat-toggle-screensaver"},
  "trigger.toggle.reading-mode": {"icon":"󰗚","label":"Reading Mode","action":"midhat-toggle-reading-mode","checked":"midhat-toggle-reading-mode status >/dev/null"},
  "trigger.toggle.mic-camera": {"icon":"󰍬","label":"Mic & Camera","action":"midhat-toggle-mic-camera","checked":"midhat-toggle-mic-camera status >/dev/null"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"midhat-toggle-nightlight"},
  "trigger.toggle.rotation-lock": {"icon":"󰑸","label":"Rotation Lock","action":"midhat-toggle-rotation-lock","checked":"[[ -f ~/.local/state/midhat/indicators/rotation-lock ]]"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"midhat-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"midhat-hw-laptop","action":"midhat-shell midhat.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"midhat-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"midhat-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"midhat-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"midhat-shell shell summon midhat.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"midhat-shell shell summon midhat.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(midhat-theme-switcher); [[ -n $theme ]] && midhat-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(midhat-theme-bg-switcher); [[ -n $background ]] && midhat-theme-bg-set \"$background\""},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"midhat-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"midhat-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"midhat-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"midhat-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"midhat-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"midhat-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"midhat-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"midhat-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"midhat-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"midhat-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"midhat-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"midhat-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"midhat-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"midhat-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"midhat-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(midhat-dns)\" == \"DHCP\" ]]","action":"midhat-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(midhat-dns)\" == \"Cloudflare\" ]]","action":"midhat-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(midhat-dns)\" == \"Google\" ]]","action":"midhat-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(midhat-dns)\" == \"Custom\" ]]","action":"midhat-launch-floating-terminal-with-presentation 'midhat-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(midhat-network-status) == wifi* ]]","action":"midhat-shell shell summon midhat.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(midhat-default-agent)\" == \"claude\" ]]","action":"midhat-default-agent claude"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"midhat-cmd-present chromium","checked":"[[ \"$(midhat-default-browser)\" == \"chromium\" ]]","action":"midhat-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"midhat-cmd-present google-chrome-stable","checked":"[[ \"$(midhat-default-browser)\" == \"chrome\" ]]","action":"midhat-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"midhat-cmd-present brave","checked":"[[ \"$(midhat-default-browser)\" == \"brave\" ]]","action":"midhat-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"midhat-cmd-present brave-origin","checked":"[[ \"$(midhat-default-browser)\" == \"brave-origin\" ]]","action":"midhat-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"midhat-cmd-present microsoft-edge-stable","checked":"[[ \"$(midhat-default-browser)\" == \"edge\" ]]","action":"midhat-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"midhat-cmd-present firefox","checked":"[[ \"$(midhat-default-browser)\" == \"firefox\" ]]","action":"midhat-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"midhat-cmd-present zen-browser","checked":"[[ \"$(midhat-default-browser)\" == \"zen\" ]]","action":"midhat-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"midhat-cmd-present alacritty","checked":"[[ \"$(midhat-default-terminal)\" == \"alacritty\" ]]","action":"midhat-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"midhat-cmd-present foot","checked":"[[ \"$(midhat-default-terminal)\" == \"foot\" ]]","action":"midhat-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"midhat-cmd-present ghostty","checked":"[[ \"$(midhat-default-terminal)\" == \"ghostty\" ]]","action":"midhat-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"midhat-cmd-present kitty","checked":"[[ \"$(midhat-default-terminal)\" == \"kitty\" ]]","action":"midhat-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"midhat-cmd-present nvim","checked":"[[ \"$(midhat-default-editor)\" == \"nvim\" ]]","action":"midhat-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"midhat-cmd-present code","checked":"[[ \"$(midhat-default-editor)\" == \"code\" ]]","action":"midhat-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"midhat","label":"Cursor","when":"midhat-cmd-present cursor","checked":"[[ \"$(midhat-default-editor)\" == \"cursor\" ]]","action":"midhat-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"midhat-cmd-present zeditor","checked":"[[ \"$(midhat-default-editor)\" == \"zeditor\" ]]","action":"midhat-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"midhat-cmd-present sublime_text","checked":"[[ \"$(midhat-default-editor)\" == \"sublime_text\" ]]","action":"midhat-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"midhat-cmd-present helix","checked":"[[ \"$(midhat-default-editor)\" == \"helix\" ]]","action":"midhat-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"midhat-cmd-present vim","checked":"[[ \"$(midhat-default-editor)\" == \"vim\" ]]","action":"midhat-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"midhat-cmd-present emacs","checked":"[[ \"$(midhat-default-editor)\" == \"emacs\" ]]","action":"midhat-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"midhat-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"midhat-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"midhat-launch-floating-terminal-with-presentation 'midhat-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"midhat-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/midhat/plugins/*/manifest.json\"","action":"midhat-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"midhat-hw-fingerprint","action":"midhat-launch-floating-terminal-with-presentation midhat-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"midhat-launch-floating-terminal-with-presentation midhat-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"midhat-launch-floating-terminal-with-presentation midhat-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"midhat-launch-floating-terminal-with-presentation midhat-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"midhat-sudo-docker --configured","action":"midhat-launch-floating-terminal-with-presentation midhat-setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"midhat-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"midhat-launch-config-editor ~/.config/hypr/hyprsunset.conf && midhat-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"midhat-launch-config-editor ~/.XCompose && midhat-restart-xcompose"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.midhat.terminal midhat-pkg-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.midhat.terminal midhat-pkg-aur-install"},
  "install.tui": {"icon":"","label":"TUI","action":"midhat-launch-floating-terminal-with-presentation midhat-tui-install"},
  "install.style": {"icon":"","label":"Style"},
  "install.style.theme": {"icon":"󰸌","label":"Theme","action":"midhat-launch-floating-terminal-with-presentation midhat-theme-install"},
  "install.style.background": {"icon":"","label":"Background","action":"midhat-theme-bg-install"},
  "install.style.font": {"icon":"","label":"Font"},
  "install.style.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"midhat-install-font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'"},
  "install.style.font.meslo": {"icon":"","label":"Meslo LG Mono","action":"midhat-install-font 'Meslo LG Mono' ttf-meslo-nerd 'MesloLGL Nerd Font'"},
  "install.style.font.fira": {"icon":"","label":"Fira Code","action":"midhat-install-font 'Fira Code' ttf-firacode-nerd 'FiraCode Nerd Font'"},
  "install.style.font.victor": {"icon":"","label":"Victor Code","action":"midhat-install-font 'Victor Code' ttf-victor-mono-nerd 'VictorMono Nerd Font'"},
  "install.style.font.bitstream": {"icon":"","label":"Bitstream Vera Mono","action":"midhat-install-font 'Bitstream Vera Code' ttf-bitstream-vera-mono-nerd 'BitstromWera Nerd Font'"},
  "install.style.font.iosevka": {"icon":"","label":"Iosevka","action":"midhat-install-font Iosevka ttf-iosevka-nerd 'Iosevka Nerd Font Mono'"},
  "install.service": {"icon":"","label":"Service"},
  "install.development": {"icon":"󰵮","label":"Development"},
  "install.editor": {"icon":"","label":"Editor"},
  "install.terminal": {"icon":"","label":"Terminal"},
  "install.browser": {"icon":"","label":"Browser"},
  "install.gaming": {"icon":"","label":"Gaming"},
  "install.preinstalls": {"icon":"󰏓","label":"Preinstalls","when":"[[ -f $HOME/.local/state/midhat/preinstalls-removed ]]","action":"midhat-launch-floating-terminal-with-presentation midhat-install-preinstalls"},
  "install.browser.chrome": {"icon":"","label":"Chrome","when":"! midhat-pkg-present google-chrome","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-browser chrome'"},
  "install.browser.brave": {"icon":"","label":"Brave","when":"! midhat-pkg-present brave-bin","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-browser brave'"},
  "install.browser.brave-origin": {"icon":"","label":"Brave Origin","when":"! midhat-pkg-present brave-origin-bin","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-browser brave-origin'"},
  "install.browser.firefox": {"icon":"","label":"Firefox","when":"! midhat-pkg-present firefox","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-browser firefox'"},
  "install.browser.zen": {"icon":"󰖟","label":"Zen","when":"! midhat-pkg-present zen-browser-bin","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-browser zen'"},
  "install.service.signal": {"icon":"󰭹","label":"Signal","when":"! midhat-pkg-present signal-desktop","action":"midhat-launch-floating-terminal-with-presentation midhat-install-service-signal"},
  "install.service.tailscale": {"icon":"","label":"Tailscale","when":"! midhat-pkg-present tailscale","action":"midhat-launch-floating-terminal-with-presentation midhat-install-service-tailscale"},
  "install.editor.vscode": {"icon":"","label":"VSCode","when":"! midhat-pkg-present visual-studio-code-bin","action":"midhat-launch-floating-terminal-with-presentation midhat-install-editor-vscode"},
  "install.editor.helix": {"icon":"","label":"Helix","when":"! midhat-pkg-present helix","action":"midhat-launch-floating-terminal-with-presentation midhat-install-editor-helix"},
  "install.editor.vim": {"icon":"","label":"Vim","when":"! midhat-pkg-present vim","action":"midhat-install-app Vim vim"},
  "install.editor.emacs": {"icon":"","label":"Emacs","when":"! midhat-pkg-present midhat-emacs","action":"midhat-launch-floating-terminal-with-presentation midhat-install-editor-emacs"},
  "install.terminal.alacritty": {"icon":"","label":"Alacritty","when":"! midhat-pkg-present alacritty","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-terminal alacritty'"},
  "install.terminal.foot": {"icon":"","label":"Foot","when":"! midhat-pkg-present foot","action":"midhat-launch-floating-terminal-with-presentation 'midhat-install-terminal foot'"},
