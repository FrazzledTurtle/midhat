# Lets the video group switch USB cameras off and on (midhat-toggle-mic-camera):
# a camera's video interface opens its device's authorized attribute to the group.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="0e", RUN+="/usr/bin/chgrp video /sys%p/../authorized", RUN+="/usr/bin/chmod g+w /sys%p/../authorized"
