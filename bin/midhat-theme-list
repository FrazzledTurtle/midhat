#!/bin/bash

# midhat:summary=List available themes
# midhat:examples=midhat theme list | midhat theme set "E Ink Mono"

{
  find ~/.config/midhat/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$MIDHAT_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
