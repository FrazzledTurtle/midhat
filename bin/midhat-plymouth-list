#!/bin/bash

# midhat:summary=List themes that can style the Plymouth boot screen
# midhat:examples=midhat plymouth list

{
  find ~/.config/midhat/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$MIDHAT_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(midhat-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
