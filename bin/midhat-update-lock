#!/bin/bash

# midhat:summary=Run a command while holding the Mid’hat update lock
# midhat:args=<held|run> [command] [args...]
# midhat:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/midhat-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${MIDHAT_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$MIDHAT_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$MIDHAT_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$MIDHAT_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: midhat-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {MIDHAT_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$MIDHAT_UPDATE_LOCK_FD"; then
      echo "A Mid’hat update is already running."
      exit 1
    fi

    export MIDHAT_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: midhat-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
