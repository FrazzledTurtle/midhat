#!/bin/bash

# midhat:summary=Update the active Mid’hat dev checkout

set -euo pipefail

[[ $MIDHAT_PATH != "/usr/share/midhat" ]] || exit 0

if ! git -C "$MIDHAT_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: MIDHAT_PATH is not a git checkout: $MIDHAT_PATH" >&2
  exit 1
fi

upstream=$(git -C "$MIDHAT_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Mid’hat dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Mid’hat dev checkout\e[0m"
git -C "$MIDHAT_PATH" pull --ff-only
