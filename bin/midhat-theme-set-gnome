#!/bin/bash

# midhat:summary=Apply the current theme to GNOME color mode and icon settings
# midhat:hidden=true

# gsettings needs a user DBus session. During ISO installs this command can be
# reached from arch-chroot while applying the initial Mid’hat theme; defer until
# the user has a real session instead of emitting dconf warnings.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  exit 0
fi

THEME_DIR=$HOME/.local/state/midhat/current/theme
COLORS_FILE="$THEME_DIR/colors.toml"

# midhat-theme-color resolves mode from colors.toml (`mode = "light"`), a
# legacy light.mode marker beside it, or background luminance for user themes.
mode=$(midhat-theme-color --file "$COLORS_FILE" mode)

if [[ $mode == "light" ]]; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
else
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
fi

# Change gnome icon theme color
GNOME_ICONS_THEME=$HOME/.local/state/midhat/current/theme/icons.theme
if [[ -f $GNOME_ICONS_THEME ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$(<$GNOME_ICONS_THEME)"
else
  gsettings set org.gnome.desktop.interface icon-theme "Yaru-blue"
fi

# A theme can ship GTK styles and a cursor, as the E Ink themes do: link the
# styles in and set the cursor, or undo both for a theme without them.
link_or_clear() {
  if [[ -f $THEME_DIR/$1 ]]; then
    mkdir -p "${2%/*}"
    ln -sfn "$THEME_DIR/$1" "$2"
  elif [[ -L $2 ]] && [[ $(readlink "$2") == "$THEME_DIR/"* || $(readlink "$2") == "$HOME/.config/midhat/themes/"* ]]; then
    rm -f "$2"
  fi
}

link_or_clear gtk3.css "$HOME/.config/gtk-3.0/gtk.css"
link_or_clear gtk4.css "$HOME/.config/gtk-4.0/gtk.css"

cursor=default
[[ -f $THEME_DIR/cursor.theme ]] && cursor=$(<"$THEME_DIR/cursor.theme")
gsettings set org.gnome.desktop.interface cursor-theme "$cursor"
hyprctl setcursor "$cursor" 24 >/dev/null 2>&1
