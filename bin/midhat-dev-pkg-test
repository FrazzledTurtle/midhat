#!/bin/bash

# midhat:summary=Build and install a Mid’hat package from a local checkout
# midhat:group=dev
# midhat:args=[package-name] [path-to-checkout]
# midhat:examples=midhat dev pkg-test | midhat dev pkg-test oskar ~/Work/midhat-os

set -euo pipefail

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  cat <<USAGE
Usage: midhat dev pkg-test [package-name] [path-to-checkout]

Builds and installs a Mid’hat package from a local Mid’hat source
checkout, working tree included. Use it to try changes before a release, or
when they land at fixed system paths (/etc/, /usr/lib/systemd/, udev rule
bodies) that midhat-dev-link can't shadow.

Defaults:
  packages          midhat-settings midhat
  path-to-checkout  the git checkout you are in

Examples:
  midhat dev pkg-test
  midhat dev pkg-test oskar
  midhat dev pkg-test midhat ~/Work/midhat-os

The package keeps its real pkgver (the PKGBUILDs check it against the
version file); pkgrel becomes <pkgrel>.<yymmddHHMM> so each test build is
newer than the last, and pkgdesc ends in [dev <short-sha>[.dirty]] so
'pacman -Qi' shows where the installed build came from.

PKGBUILDs are read from \${MIDHAT_PKGBUILDS_DIR:-<path-to-checkout>/pkgbuilds}/<package-name>/.
USAGE
  exit 0
fi

remove_pkgver_function() {
  local pkgbuild="$1"
  local tmp="$pkgbuild.tmp"

  awk '
    /^pkgver\(\)[[:space:]]*\{/ {
      in_pkgver = 1
      depth = 0
    }
    in_pkgver {
      line = $0
      opens = gsub(/\{/, "{", line)
      line = $0
      closes = gsub(/\}/, "}", line)
      depth += opens - closes
      if (depth <= 0) {
        in_pkgver = 0
      }
      next
    }
    { print }
  ' "$pkgbuild" >"$tmp"
  mv "$tmp" "$pkgbuild"
}

if (( $# == 0 )); then
  PKGS=(midhat-settings midhat)
else
  PKGS=("$1")
fi
CHECKOUT="${2:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
MAKEPKG_ARGS=("${@:3}")
PKGBUILDS_ROOT="${MIDHAT_PKGBUILDS_DIR:-$CHECKOUT/pkgbuilds}"

if [[ ! -d "$CHECKOUT" ]]; then
  echo "Error: checkout not found at $CHECKOUT" >&2
  exit 1
fi
for PKG in "${PKGS[@]}"; do
  PKGBUILD_DIR="$PKGBUILDS_ROOT/$PKG"
  if [[ ! -f "$PKGBUILD_DIR/PKGBUILD" ]]; then
    echo "Error: PKGBUILD not found at $PKGBUILD_DIR/PKGBUILD" >&2
    echo "       Pass a different package name as arg 1, or set MIDHAT_PKGBUILDS_DIR." >&2
    exit 1
  fi
done

build_dir=$(mktemp -d -t midhat-dev-pkg-test.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT

short_sha=$(git -C "$CHECKOUT" rev-parse --short HEAD 2>/dev/null || echo "local")
dirty=""
if [[ -d "$CHECKOUT/.git" ]] && [[ -n "$(git -C "$CHECKOUT" status --porcelain)" ]]; then
  dirty=".dirty"
fi
dev_tag="dev ${short_sha}${dirty}"
build_stamp=$(date +%y%m%d%H%M)
built_pkgs=()

for PKG in "${PKGS[@]}"; do
  PKGBUILD_DIR="$PKGBUILDS_ROOT/$PKG"
  package_build_dir="$build_dir/$PKG"
  mkdir -p "$package_build_dir"
  cp -a "$PKGBUILD_DIR/." "$package_build_dir/"

  remove_pkgver_function "$package_build_dir/PKGBUILD"
  sed -i -e "s/^pkgrel=\([0-9]*\).*/pkgrel=\1.${build_stamp}/" \
    -e "s/^pkgdesc=\(['\"]\)\(.*\)\1\$/pkgdesc=\1\2 [${dev_tag}]\1/" "$package_build_dir/PKGBUILD"

  echo "Building $PKG ($dev_tag) from $CHECKOUT"
  echo "  build dir: $package_build_dir"
  echo "  PKGBUILD : $PKGBUILD_DIR/PKGBUILD"
  echo

  (
    cd "$package_build_dir"
    MIDHAT_SRC="$CHECKOUT" makepkg -s --skipchecksums --noconfirm "${MAKEPKG_ARGS[@]}"
  )

  built_pkg=$(ls -t "$package_build_dir"/*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -1)
  if [[ -z $built_pkg ]]; then
    echo "Error: no built package found in $package_build_dir" >&2
    exit 1
  fi
  built_pkgs+=("$built_pkg")
done

# One transaction for everything built. Installed separately from makepkg so we can pass
# --overwrite='*' (makepkg -i can't): dev builds frequently conflict with files
# left behind by previous script-installed Mid’hat versions; the build is the
# authoritative state.
sudo pacman -U --noconfirm --overwrite='*' "${built_pkgs[@]}"
