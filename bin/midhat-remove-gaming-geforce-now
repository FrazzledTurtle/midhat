#!/bin/bash

# midhat:summary=Remove the GeForce NOW Flatpak app and its data.
# midhat:group=remove
# midhat:name=gaming geforce-now

set -e

if midhat-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
