#!/bin/bash

# midhat:summary=Log out after closing application windows
# midhat:examples=midhat logout | midhat system logout
# midhat:aliases=midhat logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

midhat-osd -i logout -m "Logging out" -d 5000

# Now close all windows
midhat-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
