#!/bin/bash

# midhat:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  midhat-brightness-keyboard-mute on
  midhat-osd -i microphone-muted -m "Microphone muted"
else
  midhat-brightness-keyboard-mute off
  midhat-osd -i microphone -m "Microphone on"
fi
