#!/bin/bash

# midhat:summary=Control the Mid’hat menu (toggle / summon / close / refresh)
# midhat:args=[toggle|summon|close|refresh|ping] [route]
# midhat:examples=midhat menu | midhat menu toggle system | midhat menu summon style.theme | midhat menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `midhat.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec midhat-shell shell toggle midhat.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec midhat-shell shell summon midhat.menu "$(menu_payload "$route")"
    ;;
  close)
    exec midhat-shell shell hide midhat.menu
    ;;
  refresh | ping)
    exec midhat-shell shell call midhat.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: midhat menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "midhat-menu: unknown verb '$verb'. Try 'midhat menu --help'." >&2
    exit 2
    ;;
esac
