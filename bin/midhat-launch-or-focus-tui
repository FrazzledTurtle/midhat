#!/bin/bash

# midhat:summary=Launch a TUI or focus an existing terminal window for it
# midhat:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.midhat.$(basename "$1")"
fi

LAUNCH_COMMAND="midhat-launch-tui $@"

exec midhat-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
