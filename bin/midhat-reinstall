#!/bin/bash

# midhat:summary=Reinstall Mid’hat packages and reset default configs
# midhat:requires-sudo=true

set -e

echo -e "This will reinstall all default Mid’hat packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  midhat-reinstall-pkgs
  midhat-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && midhat-system-reboot
fi
