#!/bin/bash

# midhat:summary=Launch a floating terminal with the Mid’hat presentation wrapper
# midhat:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source midhat-restart-gum

cmd="$*"
presentation_script="midhat-show-logo; $cmd; if (( \$? != 130 )); then midhat-show-done; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.midhat.terminal --title=Midhat -e bash -c "$presentation_script"
