#!/bin/bash

# midhat:summary=Print the active Mid’hat package channel

set -euo pipefail

# Dev is a linked source checkout: MIDHAT_PATH points somewhere other than
# the package-backed install at /usr/share/midhat. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $MIDHAT_PATH != "/usr/share/midhat" ]]; then
  echo dev
  exit 0
fi

# midhat-dev / midhat-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. midhat / midhat-settings come
# from either the stable or rc mirror, distinguished by midhat-version-channel
# (which reports the mirror as its first token).
if pacman -Q midhat-dev midhat-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q midhat midhat-settings >/dev/null 2>&1; then
  channel=$(midhat-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
