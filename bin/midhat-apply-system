#!/bin/bash

# midhat:summary=Apply Mid’hat system setup in the installed target
# midhat:group=apply
# midhat:requires-sudo=true
# midhat:examples=midhat apply system --install-user dhh --first-install
# midhat:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: midhat apply system --install-user USER [--first-install|--upgrade]
       midhat apply system --defer-provisioning --first-install

Runs root-owned Mid’hat system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
midhat-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/midhat/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${MIDHAT_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: midhat-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export MIDHAT_INSTALL_USER="$install_user"
export MIDHAT_FIRST_INSTALL="$first_install"
export MIDHAT_UPGRADE="$upgrade"
export MIDHAT_PATH="${MIDHAT_PATH:-/usr/share/midhat}"
export MIDHAT_INSTALL="${MIDHAT_INSTALL:-$MIDHAT_PATH/install}"
export MIDHAT_INSTALL_LOG_FILE="${MIDHAT_INSTALL_LOG_FILE:-/var/log/midhat-install.log}"
export PATH="$MIDHAT_PATH/bin:$PATH"

source "$MIDHAT_INSTALL/helpers/logging.sh"
start_install_log

source "$MIDHAT_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  midhat-apply-hardware --defer-provisioning
else
  midhat-apply-hardware --install-user "$install_user"
fi

source "$MIDHAT_INSTALL/login/all.sh"
source "$MIDHAT_INSTALL/post-install/all.sh"

stop_install_log
