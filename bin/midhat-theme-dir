#!/bin/bash

# midhat:summary=Print the directory holding a theme, preferring a user-installed copy
# midhat:args=<theme-name>
# midhat:examples=midhat theme dir e-ink-mono

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: midhat-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/midhat/themes/$theme ]]; then
  echo "$HOME/.config/midhat/themes/$theme"
else
  echo "$MIDHAT_PATH/themes/$theme"
fi
