#!/bin/bash

# midhat:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Mid’hat default and rebuild it.
# midhat:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$MIDHAT_PATH/bin/midhat-plymouth-set" --refresh-default
