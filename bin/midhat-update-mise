#!/bin/bash

# midhat:summary=Update mise-managed tools

if midhat-cmd-present mise; then
  echo -e "\e[32m\nUpdate mise tools\e[0m"

  # mise withholds releases younger than its cooldown, so tools stay behind for
  # days after they ship. Running midhat update is the user asking for current
  # versions now, which is the same call the mup alias makes by hand.
  MISE_MINIMUM_RELEASE_AGE=0 mise up

  # Old tool versions are never removed otherwise; on a 64 GB tablet a few
  # weeks of Claude Code releases add up to gigabytes.
  mise prune --yes
fi
