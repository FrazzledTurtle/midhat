#!/bin/bash

# midhat:summary=Select and set the system timezone
# midhat:group=menu
# midhat:name=timezone

set -e

timezone=$(timedatectl list-timezones | midhat-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
midhat-shell -q midhat.clock refresh
midhat-notification-send "Timezone is now set to $timezone"
