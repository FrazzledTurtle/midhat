#!/bin/bash

# midhat:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# midhat:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
midhat-pkg-add heroic-games-launcher-bin
midhat-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
