#!/bin/bash

# midhat:summary=Launch the default coding agent with a prompt
# midhat:args=[--inline] <prompt...>
# midhat:examples=midhat agent prompt "Review this project"

# Prompts live here rather than on `midhat agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: midhat agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec midhat-agent "${inline[@]}" --prompt "$*"
