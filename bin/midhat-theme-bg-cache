#!/bin/bash

# midhat:summary=Cache background switcher thumbnails for the current theme

theme_name=$(cat "$HOME/.local/state/midhat/current/theme.name" 2>/dev/null)

midhat-menu-images \
  --cache-only \
  "$HOME/.local/state/midhat/current/theme/backgrounds" \
  "$HOME/.config/midhat/backgrounds/$theme_name"
